# Local dev backend (auto-loaded by Vite in development only).
# The dev client talks to a local server (`cargo run` in lqxp/lqxp, :4560),
# never to production. Production builds are unaffected.
VITE_QXP_SERVER_ORIGIN=http://localhost:4560
VITE_QXP_API_BASE_URL=http://localhost:4560
VITE_QXP_WS_URL=ws://localhost:4560/ws
