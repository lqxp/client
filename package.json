{
  "name": "qxpclient",
  "private": true,
  "version": "1.15.6",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "inject": "node ./scripts/sync-runtime-config.mjs --out dist/runtime-config.js",
    "build": "vite build && bun run inject",
    "build:dev": "bun run inject -- --watch & vite build --watch",
    "build:web": "bun run build",
    "sync:runtime": "node ./scripts/sync-runtime-config.mjs",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "build:tauri": "vite build && node ./scripts/sync-runtime-config.mjs --out dist/runtime-config.js"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@tauri-apps/api": "2",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-process": "^2.3.0",
    "@tauri-apps/plugin-updater": "2.10.1",
    "fflate": "^0.8.2",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.1",
    "@types/node": "^25.6.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vue-tsc": "^2.2.10"
  }
}
